{
  "name": "zoecomsos",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm run db:migrate:deploy && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@clerk/nextjs": "^7.10.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^5.22.0",
    "@upstash/redis": "^1.41.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "isomorphic-dompurify": "^2.21.0",
    "js-cookie": "^3.0.5",
    "motion": "^12.4.1",
    "next": "^15.2.8",
    "react": "^19.0.0",
    "react-confetti": "^6.2.3",
    "react-dom": "^19.0.0",
    "timeago.js": "^4.0.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.49.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "22.13.0",
    "@types/react": "19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^15.2.8",
    "happy-dom": "^15.11.6",
    "postcss": "^8.5.1",
    "prettier": "3.5.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
