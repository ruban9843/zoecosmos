
# ────────── Neon PostgreSQL ──────────
# Pooled connection used by Vercel application requests.
DATABASE_URL=""

# Direct/unpooled connection used only for Prisma migrations and maintenance.
DIRECT_URL=""

DATABASE_URL_UNPOOLED=""

# ────────── Upstash Redis ──────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Trusted proxy hops (Vercel / nginx = 1)
TRUSTED_PROXY_HOPS=1

# ────────── NextAuth ──────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"



# ────────── Google OAuth (Optional) ──────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ────────── Neon Object Storage / S3 ──────────
STORAGE_PROVIDER=neon

S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=uploads
S3_PUBLIC_URL=""

# ────────── AWS / Neon Storage ──────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=ap-southeast-1

# ────────── Neon Configuration ──────────
NEON_BRANCH=production
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=.compute.ap-southeast-1.aws.neon.tech

# ────────── App ──────────
APP_URL="http://localhost:3000"
SHOP_CURRENCY=INR

# OpenMail order notifications (server-only)
OPENMAIL_API_KEY=""
OPENMAIL_INBOX_ID=""
OPENMAIL_ADDRESS=""

# ────────── Seeded Owner Account ──────────
OWNER_EMAIL=owner@flower-shop.local
ADMIN_EMAIL=admin@flower-shop.local

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/daily (06:00 IST).
# Use a long random value; the job refuses to run without it.
CRON_SECRET=""
OWNER_PASSWORD=""

# ────────── Clerk Authentication ──────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
